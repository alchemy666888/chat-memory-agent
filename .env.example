# Runtime role. Prefer verify-full TLS. Loose sslmode values are upgraded.
DATABASE_URL=postgres://chat_memory_runtime:password@hostname:5432/chat_memory?sslmode=verify-full

# Privileged URL used only by `pnpm db:init`. Do not use this in the running service.
DATABASE_MIGRATOR_URL=postgres://migrator:password@hostname:5432/chat_memory?sslmode=verify-full

# Optional custom PostgreSQL CA. PEM, with literal \n, or base64 PEM.
AIVEN_PG_CA=

# Existing login roles. The initializer grants DML to the runtime role and SELECT to the MCP role.
CHAT_MEMORY_RUNTIME_ROLE=chat_memory_runtime
CHAT_MEMORY_MCP_ROLE=chat_memory_mcp

# Distinct bearer tokens. The process token stays with the operator, not the bot.
CHAT_MEMORY_INGEST_TOKEN=
CHAT_MEMORY_PROCESS_TOKEN=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SUMMARY_MODEL=deepseek-v4-pro

MEMORY_PROCESS_TIMEOUT_MS=240000
MEMORY_BATCH_MAX_MESSAGES=100
MEMORY_BATCH_MAX_CHARACTERS=64000
